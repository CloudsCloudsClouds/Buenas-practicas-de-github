<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinderCalibracion"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#AA000000"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtInstruccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calibrando ojo dominante..."
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/pbarCalibracion"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:progress="0"
            android:max="100" />

        <TextView
            android:id="@+id/txtResultadoOjo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#00FFFF"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnIrANavegacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="INICIAR NAVEGACIÓN"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>